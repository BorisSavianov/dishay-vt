# Copy to web/.env.local for local runs. On Vercel, set the same names in
# Project Settings > Environment Variables. Keys are server-only: never give
# them a NEXT_PUBLIC_ prefix.

# Neon Postgres connection string. Leave empty to show the bundled data.
DATABASE_URL=

# Groq (primary). Leave the key empty to skip Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (fallback). Leave the key empty to skip Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# With no key set, or MOCK_LLM=1, the summary is text built from the figures.
MOCK_LLM=0

# Live AI calls allowed per visitor (IP) per minute and per day.
AI_PER_MINUTE=5
AI_PER_DAY=50
